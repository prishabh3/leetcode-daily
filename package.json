{
  "name": "lc-sync",
  "version": "1.0.0",
  "description": "LC-Sync: A Personal DSA Learning and GitHub Automation Platform",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && esbuild src/content/content-script.ts --bundle --minify --outfile=dist/content.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.308",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vitest": "^3.0.8"
  }
}
